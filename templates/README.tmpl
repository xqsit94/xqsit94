<p align="center">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="./assets/dark_mode.svg" />
    <source media="(prefers-color-scheme: light)" srcset="./assets/light_mode.svg" />
    <img alt="{{.Profile.DisplayName}} — {{.Profile.Title}}" src="./assets/light_mode.svg" />
  </picture>
</p>

<p align="center">
  <a href="{{.Profile.Links.Website.URL}}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="./assets/btn_website_dark.svg" />
      <img alt="{{.Profile.Links.Website.Label}}" src="./assets/btn_website_light.svg" height="32" />
    </picture>
  </a>
  &nbsp;
  <a href="{{.Profile.Links.LinkedIn.URL}}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="./assets/btn_linkedin_dark.svg" />
      <img alt="LinkedIn" src="./assets/btn_linkedin_light.svg" height="32" />
    </picture>
  </a>
  &nbsp;
  <a href="mailto:{{.Profile.Email}}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="./assets/btn_email_dark.svg" />
      <img alt="Email" src="./assets/btn_email_light.svg" height="32" />
    </picture>
  </a>
</p>
{{if .ShowPosts}}
## 📝 Latest Posts
{{range .Posts}}- [{{.Title}}]({{.Link}})
{{end}}
{{- end}}
<details>
  <summary>Experience ({{.Profile.TotalExperience}})</summary>

  {{range .Profile.Experience}}#### {{.Company}}
  *{{.Role}}*

  <sup>{{.DateRange}} ({{.Duration}}) • {{.Location}}</sup>

  ---
  {{end}}
</details>

<details>
  <summary>Education</summary>

  {{range .Profile.Education}}#### {{.Institution}}
  *{{.Degree}}*

  <sup>{{.StartYear}} - {{.EndYear}}</sup>

  ---
  {{end}}
</details>
